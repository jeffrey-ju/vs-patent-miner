\documentclass[$if(fontsize)$$fontsize$,$endif$$if(lang)$$babel-lang$,$endif$]{article}

% Geometry
\usepackage[margin=1in]{geometry}

% CJK Support — uses macOS system fonts with fallbacks
\usepackage{xeCJK}
\setCJKmainfont[BoldFont=Heiti TC]{Songti TC}
\setCJKsansfont{Heiti TC}
\setCJKmonofont{Heiti TC}

% Fonts — uses macOS system fonts with fallbacks
\usepackage{fontspec}
\setmainfont{Helvetica}
\setsansfont{Helvetica}
\setmonofont{Courier New}

% Tables
\usepackage{longtable}
\usepackage{booktabs}
\usepackage{array}

% Graphics
\usepackage{graphicx}
\usepackage{float}

% Colors
\usepackage{xcolor}
\definecolor{vsblue}{RGB}{0, 82, 147}
\definecolor{vsgray}{RGB}{88, 89, 91}

% Headers — CONFIDENTIAL on right, ID on left
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\small\textcolor{vsgray}{$application_number$ Patent Disclosure}}
\fancyhead[R]{\small\textbf{CONFIDENTIAL}}
\fancyfoot[C]{\thepage}
\renewcommand{\headrulewidth}{0.4pt}

% Title formatting — no auto-numbering (we number manually in Markdown)
\usepackage{titlesec}
\titleformat{\section}{\Large\bfseries\color{vsblue}}{}{0em}{}
\titleformat{\subsection}{\large\bfseries\color{vsblue}}{}{0em}{}
\titleformat{\subsubsection}{\normalsize\bfseries}{}{0em}{}

% Disable auto-numbering — we number manually in the Markdown
\setcounter{secnumdepth}{-1}
\setcounter{tocdepth}{2}

% Prevent orphaned headings — keep heading with at least 3 lines after it
\titlespacing*{\section}{0pt}{12pt plus 4pt minus 2pt}{6pt plus 2pt minus 2pt}
\titlespacing*{\subsection}{0pt}{10pt plus 4pt minus 2pt}{4pt plus 2pt minus 2pt}
\titlespacing*{\subsubsection}{0pt}{8pt plus 4pt minus 2pt}{4pt plus 2pt minus 2pt}

\usepackage{needspace}
\AddToHook{cmd/section/before}{\needspace{5\baselineskip}}
\AddToHook{cmd/subsection/before}{\needspace{4\baselineskip}}

% Hyperlinks
\usepackage{hyperref}
\hypersetup{
    colorlinks=true,
    linkcolor=vsblue,
    urlcolor=vsblue,
    citecolor=vsblue
}

% Code blocks
\usepackage{listings}
\lstset{
    basicstyle=\ttfamily\small,
    breaklines=true,
    frame=single,
    backgroundcolor=\color{gray!10}
}

% Lists
\usepackage{enumitem}
\setlist[itemize]{leftmargin=*, topsep=4pt, itemsep=2pt}
\setlist[enumerate]{leftmargin=*, topsep=4pt, itemsep=2pt}

% Paragraph spacing
\setlength{\parskip}{6pt plus 2pt minus 1pt}
\setlength{\parindent}{0pt}

% Pandoc compatibility
\providecommand{\tightlist}{\setlength{\itemsep}{0pt}\setlength{\parskip}{0pt}}

\begin{document}

% Title Page
\begin{titlepage}
\centering

\vspace*{1cm}
{\small\textbf{CONFIDENTIAL --- ATTORNEY-CLIENT PRIVILEGE}\par}
\vspace{0.5cm}
\rule{\textwidth}{1pt}
\vspace{1.5cm}

{\Huge\bfseries\color{vsblue} Patent Disclosure Document\par}
\vspace{0.8cm}
{\Large $title$\par}
\vspace{2cm}

\begin{tabular}{ll}
\textbf{Application Number:} & $application_number$ \\[4pt]
\textbf{Priority Date:} & $priority_date$ \\[4pt]
\textbf{Inventors:} & $for(inventors)$$inventors$$sep$, $endfor$ \\[4pt]
\textbf{Assignee:} & $assignee$ \\
\end{tabular}

\vspace{2cm}
{\large\today\par}

\vfill

{\small $assignee$\par}
{\small Internal --- Restricted Distribution\par}

\end{titlepage}

% Table of Contents
\tableofcontents
\newpage

% Main Content
$body$

\vfill
\begin{center}
\rule{0.5\textwidth}{0.4pt}\\[6pt]
{\small\textit{This document is confidential and proprietary to $assignee$.}}
\end{center}

\end{document}
